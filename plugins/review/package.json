{
  "name": "@lidtop/opencode-review",
  "version": "0.0.0",
  "description": "Comment on the agent's diffs in OpenCode while it works, and send the comments to steer it",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "code-review"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ZackarySantana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackarySantana/opcode.git",
    "directory": "plugins/review"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "engines": {
    "opencode": "^2.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opcode/core": "workspace:*",
    "@opcode/tabs": "workspace:*",
    "@opcode/ui": "workspace:*",
    "@opencode/client": "catalog:",
    "@opencode/plugin": "catalog:",
    "@opencode/schema": "catalog:",
    "@opencode/theme": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "catalog:host",
    "@opentui/solid": "catalog:host",
    "solid-js": "catalog:host"
  }
}
