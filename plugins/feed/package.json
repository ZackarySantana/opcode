{
  "name": "@lidtop/opencode-feed",
  "version": "0.4.3",
  "description": "Follow RSS and Atom feeds in the OpenCode sidebar",
  "keywords": [
    "opencode",
    "opencode-plugin"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ZackarySantana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackarySantana/opcode.git",
    "directory": "plugins/feed"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "engines": {
    "opencode": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opcode/core": "workspace:*",
    "@opcode/tabs": "workspace:*",
    "@opcode/ui": "workspace:*",
    "@opencode/plugin": "catalog:",
    "@opencode/client": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "catalog:host",
    "@opentui/solid": "catalog:host",
    "solid-js": "catalog:host"
  }
}
