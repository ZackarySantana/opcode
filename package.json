{
  "name": "opcode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": ["packages/*", "plugins/*"],
    "catalog": {
      "@changesets/cli": "2.31.1",
      "@xterm/headless": "6.0.0",
      "@opencode/plugin": "2.2.0",
      "@opencode/client": "2.2.0",
      "@opencode/schema": "2.2.0",
      "@opencode/theme": "2.2.0",
      "@opentui/core": "0.7.0",
      "@opentui/solid": "0.7.0",
      "solid-js": "1.9.12",
      "@types/bun": "1.4.0",
      "typescript": "5.8.2",
      "vite": "8.3.5",
      "vite-plugin-solid": "2.11.14"
    },
    "catalogs": {
      "host": {
        "@opentui/core": ">=0.7.0 <1",
        "@opentui/solid": ">=0.7.0 <1",
        "solid-js": ">=1.9.12 <2"
      }
    }
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "prod": "bun scripts/prod.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gui.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@xterm/headless": "catalog:",
    "@opencode/plugin": "catalog:",
    "@opencode/client": "catalog:",
    "@opencode/schema": "catalog:",
    "@opencode/theme": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "solid-js": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
